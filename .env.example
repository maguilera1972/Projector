# Clé secrète pour signer les sessions (obligatoire en production)
PROJECTOR_SECRET=changez-moi-par-une-valeur-aleatoire-longue

# URL publique (HTTPS derrière reverse proxy / Cloudflare)
# PROJECTOR_PUBLIC_URL=https://projector.example.com

# Cookies Secure=true si l'accès se fait en HTTPS
# PROJECTOR_COOKIE_SECURE=true

# Chemin explicite de la base JSON (optionnel)
# PROJECTOR_DB_FILE=/var/lib/projector/projector.json

# Compte admin initial (uniquement à la création de la base — à définir par l'utilisateur)
# PROJECTOR_ADMIN_EMAIL=admin@example.com
# PROJECTOR_ADMIN_NAME=Administrateur
# PROJECTOR_ADMIN_PASSWORD=

# Documents annexes : dossier de stockage (défaut : « uploads » à côté de la base JSON)
# et taille maximale par fichier en Mo
# PROJECTOR_UPLOADS_DIR=/var/lib/projector/uploads
# PROJECTOR_UPLOAD_MAX_MB=25

# Durée de validité des invitations (jours)
# PROJECTOR_INVITATION_TTL_DAYS=7

# Microsoft Entra ID — connexion « Se connecter avec Microsoft » (OIDC + PKCE)
# URI de redirection à déclarer (plateforme Web) : ${PROJECTOR_PUBLIC_URL}/api/auth/entra/callback
# ENTRA_TENANT_ID=00000000-0000-0000-0000-000000000000
# ENTRA_CLIENT_ID=00000000-0000-0000-0000-000000000000
# ENTRA_CLIENT_SECRET=changez-moi
# ENTRA_REDIRECT_URI=https://projector.example.com/api/auth/entra/callback
# ENTRA_LOGIN_ENABLED=true

# Microsoft Graph — envoi d'e-mails (permission d'application Mail.Send)
# (peut réutiliser la même inscription d'application que ENTRA_*)
# MS_GRAPH_TENANT_ID=00000000-0000-0000-0000-000000000000
# MS_GRAPH_CLIENT_ID=00000000-0000-0000-0000-000000000000
# MS_GRAPH_CLIENT_SECRET=changez-moi
# Boîte expéditrice du tenant (boîte partagée recommandée)
# MAIL_FROM=projector@example.com

# ─── Microsoft Teams & Copilot (docs/integration-teams-copilot.md) ───────────
# Réutilise l'inscription MS_GRAPH_* (permissions d'application consenties) ; tout est facultatif.
# ID (manifeste) de l'application Teams PROJECTOR et ID dans le catalogue de l'organisation
# TEAMS_APP_ID=00000000-0000-0000-0000-000000000000
# TEAMS_APP_CATALOG_ID=00000000-0000-0000-0000-000000000000
# Bot Framework (Azure Bot mono-locataire) — défaut : MS_GRAPH_CLIENT_ID / SECRET / TENANT_ID
# TEAMS_BOT_APP_ID=00000000-0000-0000-0000-000000000000
# TEAMS_BOT_APP_SECRET=changez-moi
# TEAMS_BOT_TENANT_ID=00000000-0000-0000-0000-000000000000
# Réunions Teams : boîte organisatrice par défaut (défaut : MAIL_FROM) et fuseau horaire
# TEAMS_MEETING_ORGANIZER=projector@example.com
# TEAMS_MEETING_TIMEZONE=Europe/Zurich
# Connecteur Microsoft Graph (Copilot) : ID de connexion, groupe Entra de repli pour les ACL,
# mode d'ACL (visibility = règles de visibilité PROJECTOR, linked = personnes liées au projet)
# COPILOT_CONNECTOR_ID=projectorprojects
# COPILOT_CONNECTOR_ADMIN_GROUP_ID=00000000-0000-0000-0000-000000000000
# COPILOT_CONNECTOR_ACL_MODE=visibility
# API Copilot : audiences supplémentaires acceptées (séparées par des virgules)
# COPILOT_API_AUDIENCES=
# Packaging de l'agent Copilot (ID de référence OAuth du Teams Developer Portal)
# TEAMS_OAUTH_REFERENCE_ID=
# Tâches planifiées : secret du timer systemd (POST /api/integrations/jobs/run)
# et/ou intervalle en processus en minutes (0 = désactivé)
# PROJECTOR_CRON_SECRET=changez-moi-valeur-aleatoire
# PROJECTOR_JOBS_INTERVAL_MIN=0

# Répertoire de build Next (optionnel)
# NEXT_DIST_DIR=.local/next
# Port d'écoute (utilisé par scripts / systemd)
# PORT=3001
