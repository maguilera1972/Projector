# Clé secrète pour signer les sessions (obligatoire en production)
PROJECTOR_SECRET=changez-moi-par-une-valeur-aleatoire-longue

# URL publique (HTTPS derrière reverse proxy / Cloudflare)
# PROJECTOR_PUBLIC_URL=https://projector.example.com

# Cookies Secure=true si l'accès se fait en HTTPS
# PROJECTOR_COOKIE_SECURE=true

# Chemin explicite de la base JSON (optionnel)
# PROJECTOR_DB_FILE=/var/lib/projector/projector.json

# Compte admin initial (uniquement à la création de la base — à définir par l'utilisateur)
# PROJECTOR_ADMIN_EMAIL=admin@example.com
# PROJECTOR_ADMIN_NAME=Administrateur
# PROJECTOR_ADMIN_PASSWORD=

# Durée de validité des invitations (jours)
# PROJECTOR_INVITATION_TTL_DAYS=7

# Microsoft Entra ID — connexion « Se connecter avec Microsoft » (OIDC + PKCE)
# URI de redirection à déclarer (plateforme Web) : ${PROJECTOR_PUBLIC_URL}/api/auth/entra/callback
# ENTRA_TENANT_ID=00000000-0000-0000-0000-000000000000
# ENTRA_CLIENT_ID=00000000-0000-0000-0000-000000000000
# ENTRA_CLIENT_SECRET=changez-moi
# ENTRA_REDIRECT_URI=https://projector.example.com/api/auth/entra/callback
# ENTRA_LOGIN_ENABLED=true

# Microsoft Graph — envoi d'e-mails (permission d'application Mail.Send)
# (peut réutiliser la même inscription d'application que ENTRA_*)
# MS_GRAPH_TENANT_ID=00000000-0000-0000-0000-000000000000
# MS_GRAPH_CLIENT_ID=00000000-0000-0000-0000-000000000000
# MS_GRAPH_CLIENT_SECRET=changez-moi
# Boîte expéditrice du tenant (boîte partagée recommandée)
# MAIL_FROM=projector@example.com

# Répertoire de build Next (optionnel)
# NEXT_DIST_DIR=.local/next
# Port d'écoute (utilisé par scripts / systemd)
# PORT=3001
