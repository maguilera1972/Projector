# Clé secrète pour signer les sessions (obligatoire en production)
PROJECTOR_SECRET=changez-moi-par-une-valeur-aleatoire-longue

# URL publique (HTTPS derrière reverse proxy / Cloudflare)
# PROJECTOR_PUBLIC_URL=https://projector.example.com

# Cookies Secure=true si l'accès se fait en HTTPS
# PROJECTOR_COOKIE_SECURE=true

# Chemin explicite de la base JSON (optionnel)
# PROJECTOR_DB_FILE=/var/lib/projector/projector.json

# Compte admin initial (uniquement à la création de la base — à définir par l'utilisateur)
# PROJECTOR_ADMIN_EMAIL=admin@example.com
# PROJECTOR_ADMIN_NAME=Administrateur
# PROJECTOR_ADMIN_PASSWORD=

# Répertoire de build Next (optionnel)
# NEXT_DIST_DIR=.local/next
# Port d'écoute (utilisé par scripts / systemd)
# PORT=3001
